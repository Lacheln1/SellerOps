# 복사해서 .env로 쓴다 (.env는 git에 올라가지 않는다). 전부 로컬 개발용 값이다.

# --- docker-compose ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=sellerops
MYSQL_USER=sellerops
MYSQL_PASSWORD=sellerops
# 호스트에 MySQL이 이미 3306을 쓰고 있어서 컨테이너는 3307로 연다.
MYSQL_PORT=3307
REDIS_PORT=6379

# --- 앱 (호스트에서 실행할 때) ---
DATABASE_URL=mysql://sellerops:sellerops@127.0.0.1:3307/sellerops
REDIS_URL=redis://127.0.0.1:6379
API_PORT=3001
MOCK_MALL_PORT=3002
